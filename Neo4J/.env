USER_ID=1000
GROUP_ID=1000

# Path for Neo4j data (Expand ~ to your actual home path)
# On Manjaro, this usually resolves to /home/your-username/
# NEO4J_HOME_DATA=/home/shaphil/neo4j_storage

# On windows
NEO4J_HOME_DATA=./neo4j_storage

# Neo4j Settings
NEO4J_DOCKER_IMAGE=neo4j:2026.03.1-enterprise
NEO4J_EDITION=docker_compose
EXTENDED_CONF=yes
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
NEO4J_AUTH=neo4j/bloodyroots

# Memory Tuning (Optimized for 16GB System)
# We allocate 4GB to Neo4j to leave room for your App + LLMs
NEO4J_server_memory_pagecache_size=1G
NEO4J_server_memory_heap_initial__size=1G
NEO4J_server_memory_heap_max__size=2G

# API Keys
OPENAI_API_KEY=openai-api-secret-key